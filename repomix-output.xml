      >
        <Spin size="large" />
      </div>
    );
  }

  return (
    <>
      <div className={styles.page}>
        <h1 className={styles.title}>İstifadəçilər</h1>

        <Table<User>
          className={styles.table}
          columns={columns}
          dataSource={data}
          rowKey="id"
        />
      </div>

      <Modal
        open={isModalOpen}
        onCancel={() => setIsModalOpen(false)}
        footer={null}
        centered
