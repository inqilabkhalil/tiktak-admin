          <Button
            style={{ flex: 1, backgroundColor: 'rgba(146, 216, 113, 1)', color: '#fff', border: 'none' }}
            loading={loading}
            onClick={onConfirm}
          >
            Təsdiqlə
          </Button>
          <Button
            style={{ flex: 1, backgroundColor: '#fff', border: '1px solid #d9d9d9', color: '#8c8c8c' }}
            disabled={loading}
